{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "mcp__mlflow__create_run",
      "mcp__mlflow__delete_run",
      "mcp__mlflow__restore_run",
      "mcp__mlflow__link_traces_to_run",
      "mcp__mlflow__create_experiment",
      "mcp__mlflow__update_experiment",
      "mcp__mlflow__delete_experiment",
      "mcp__mlflow__restore_experiment",
      "mcp__mlflow__rename_experiment"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_env.py\""
          }
        ]
      }
    ]
  }
}
