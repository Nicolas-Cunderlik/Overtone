# Copy to .env (gitignored) and fill in. When running the built exe, put the
# .env next to Overtone.exe instead. Override the location with OVERTONE_ENV_FILE.

# Spotify developer app - https://developer.spotify.com/dashboard
# The redirect URI must be registered on the app and point at 127.0.0.1
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:4000

# OpenAI - AI chord suggestions
OPENAI_API_KEY=

# FreqBlog - Spotify-format audio features for songs outside the catalog
# (1000 requests/month; the app caps itself at 100/day)
FREQBLOG_API_KEY=

# Last.fm - track.getSimilar, used by the similarity research pipeline
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
