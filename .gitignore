# Secrets (copy .env.example to .env)
.env
auth.env

# Virtual environments
.venv/
venv/

# Python bytecode / packaging
__pycache__/
*.pyc
*.egg-info/

# Build output: wheels, the installer, model release zips (scripts/build_installer.py, model_release pack)
build/
dist/

# Downloaded dataset and trained models (regenerable: python -m overtone.ml.download_dataset / .train)
data/
models/

# Optional title font (licensed separately)
*.ttf

# Logs and caches - the app writes these to %LOCALAPPDATA%\Overtone, but
# older versions wrote them into the repo
*.log
*.cache
.cache
cache/
